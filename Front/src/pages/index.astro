---
import AdventCalendar from "../components/AdventCalendar";
import { loadArticles } from "../../scripts/content.ts";
import config from "../../site.config.json";
import wathematicaLogo from "../../asset/wathematica_logo.png?inline";
import "../styles.css";

// このフロントマターは静的ビルド時（開発中はリクエスト時）に実行される。
// 記事の検証・HTML化をここで終え、ブラウザにはファイル読み込みの処理を持ち込まない。
const { year } = config;
if (!Number.isInteger(year) || year < 1000 || year > 9999)
  throw new Error("site.config.json: year must be a four-digit year");
const { articles, warnings } = await loadArticles(process.cwd(), year);
// 対象期間外の記事は公開対象から外しつつ、設定や投稿日の確認に使えるようログへ残す。
warnings.forEach((warning) => console.warn(warning));
const title = `Wathematica Advent Calendar ${year}`;
const description = `${year}年のWathematicaアドベントカレンダーと記事一覧。`;
---

<!doctype html>
{/* hidden属性をTailwindの表示指定より優先し、検索で除外したカードを確実に隠す。 */}
<html
  lang="ja"
  class="box-border bg-white leading-[1.6] text-[#222] font-[system-ui,sans-serif]
  **:box-border **:[[hidden]]:hidden!"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 外部リンクへの参照元送信と、ブラウザによる外部ホストの先読みを抑える。 */}
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="x-dns-prefetch-control" content="off" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {/* faviconの自動取得を避け、ページ表示に必要なリソースを明示したものに限定する。 */}
    <link rel="icon" href="data:," />
  </head>
  <body class="mx-auto my-0  px-4">
    <a class="absolute left-[-9999px] focus:static" href="#calendar"
      >カレンダーへスキップ</a
    >
    <header id="top" class="border-b border-b-[#ccc] py-4">
      <div class="flex items-center">
        <h1 class="font-serif-jp font-bold text-2xl flex-auto">{title}</h1>
        <a
          href="https://wathematica.github.io/"
          class="block transition-all duration-300 hover:scale-110 active:rotate-12 active:scale-95"
          ><img
            src={wathematicaLogo}
            alt="Wathematicaのホームページ"
            width={48}
            height={48}
            class="h-12 w-12 rounded-full shadow-md hover:shadow-xl duration-300"
          /></a
        >
      </div>
    </header>
    <main class = "mx-auto max-w-300 px-4">
      <p class = "text-center text-sm my-10"> 『Wathematica Advent Calendar 2026』とは、Wathematicaのメンバーが12月1日から12月25日まで毎日記事を公開する企画です。</p>
      {/* 全記事をpropsに同梱し、client:loadで端末時計・検索・日付選択を有効にする。 */}
      <AdventCalendar year={year} articles={articles} client:load />
      <noscript>
        <p>日付の選択・検索と本文の表示にはJavaScriptを有効にしてください。</p>
      </noscript>
    </main>
    <footer
      class="flex flex-wrap justify-center gap-4 border-t border-t-[#ccc] py-4"
    >
      <small class="text-gray-500">@Wathematica {year}</small>
    </footer>
  </body>
</html>
