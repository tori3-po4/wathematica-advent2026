---
import AdventCalendar from "../components/AdventCalendar";
import { loadArticles } from "../../scripts/content.mjs";
import config from "../../site.config.json";
import "../styles.css";

const { year } = config;
if (!Number.isInteger(year) || year < 1000 || year > 9999)
  throw new Error("site.config.json: year must be a four-digit year");
const { articles, warnings } = await loadArticles(process.cwd(), year);
warnings.forEach((warning) => console.warn(warning));
const title = `Wathematica Advent Calendar ${year}`;
const description = `${year}年のWathematicaアドベントカレンダーと記事一覧。`;
---

<!doctype html>
<html
  lang="ja"
  class="box-border bg-white leading-[1.6] text-[#222] font-[system-ui,sans-serif]
  **:box-border **:[[hidden]]:hidden! [&_a]:text-[#0645ad]
  [&_:where(:focus-visible)]:[outline:2px_solid_#0645ad]
  [&_:where(:focus-visible)]:outline-offset-3"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="x-dns-prefetch-control" content="off" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="data:," />
  </head>
  <body class="mx-auto my-0 max-w-240 px-4">
    <a class="absolute left-[-9999px] focus:static" href="#calendar"
      >カレンダーへスキップ</a
    >
    <header id="top" class="border-b border-b-[#ccc] py-4">
      <h1 class="text-[1.5rem]">{title}</h1>
      <nav class="flex flex-wrap gap-4" aria-label="メインナビゲーション">
        <a href="#calendar">カレンダー</a>
        <a href="#articles">記事一覧</a>
      </nav>
    </header>
    <main>
      <AdventCalendar year={year} articles={articles} client:load />
      <noscript>
        <p>公開日の判定と記事の表示にはJavaScriptを有効にしてください。</p>
      </noscript>
    </main>
    <footer class="flex flex-wrap gap-4 border-t border-t-[#ccc] py-4">
      <small>Wathematica {year}</small>
      <a href="#top">ページの先頭へ</a>
    </footer>
  </body>
</html>
