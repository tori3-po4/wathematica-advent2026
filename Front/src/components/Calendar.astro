---
// Astro adaptation of the 2025 Calendar: Sunday-first, seven columns, Daytag cells.
// Article data is passed at build time instead of being read from a runtime database.
import Daytag from "./Daytag.astro";
interface Props {
  year: number;
  articles: { date: string; icon: string; author: string }[];
}
const { year, articles } = Astro.props;
const dayIconMap = new Map<number, typeof articles>();
for (const article of articles) {
  const day = Number(article.date.slice(-2));
  dayIconMap.set(day, [...(dayIconMap.get(day) || []), article]);
}
const firstWeekday = new Date(Date.UTC(year, 11, 1)).getUTCDay();
const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
---
<section id="calendar" class="calendar-section" aria-labelledby="calendar-heading">
  <div class="section-heading">
    <div><span class="eyebrow">01 / THE CALENDAR</span><h2 id="calendar-heading">12月、毎日ひとつの発見。</h2></div>
    <p class="month-label">December <span>{year}</span></p>
  </div>
  <div class="calendar-sheet">
    <div class="calendar-topline"><span>日付を選んで、記事を読む</span><span class="calendar-timezone">JAPAN STANDARD TIME</span></div>
    <ul class="weekdays" aria-hidden="true">{weekdays.map((day) => <li>{day}</li>)}</ul>
    <div class="calendar-grid" aria-label={`${year}年12月1日から25日のカレンダー`}>
      {Array.from({ length: firstWeekday }, () => <div class="calendar-blank" aria-hidden="true"></div>)}
      {Array.from({ length: 25 }, (_, i) => <Daytag year={year} day={i + 1} dayIcons={dayIconMap.get(i + 1) || []} />)}
    </div>
    <div class="calendar-legend"><span><i class="legend-dot available"></i>公開日を迎えた日</span><span><i class="legend-dot"></i>これからのお楽しみ</span><span>各日 0:00 公開 · 日本時間</span></div>
  </div>
</section>
