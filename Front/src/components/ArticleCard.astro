---
interface Props {
  article: {
    id: string; date: string; title: string; author: string; icon: string;
    abstract: string; type: string; body: string | null; url: string | null;
  };
}
const { article } = Astro.props;
const labels: Record<string, string> = { markdown: "Markdown", pdf: "PDF", external: "外部記事" };
---
<template data-article={article.id}>
  <article class="article-card" id={`article-${article.id}`} tabindex="-1">
    <div class="article-meta">
      <time datetime={article.date}>{article.date}</time>
      <span>{labels[article.type]}</span>
    </div>
    <h3><a href={`#article-${article.id}`}>{article.title}</a></h3>
    <p class="author">
      <img src={article.icon} alt="" width="28" height="28" />
      <span>{article.author}</span>
    </p>
    <div class="prose" set:html={article.abstract}></div>
    {article.type === "markdown" && (
      <details class="article-body">
        <summary>本文を表示</summary>
        <div class="prose body-content" set:html={article.body}></div>
      </details>
    )}
    {article.type === "pdf" && (
      <a class="read-link" href={`data:application/pdf;base64,${article.body}`} download={`${article.id}.pdf`}>
        PDFをダウンロード
      </a>
    )}
    {article.type === "external" && (
      <a class="read-link" href={article.url || undefined} target="_blank" rel="noopener noreferrer">
        外部サイトで読む（別タブ）
      </a>
    )}
  </article>
</template>
