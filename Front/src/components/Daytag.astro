---
// Port of Daytag in tori3-po4/wathematica-advent2025/app/calendar.tsx.
// Retains the day number, first author icon and +N badge. See THIRD_PARTY_NOTICES.md.
interface Props {
  year: number;
  day: number;
  dayIcons: { icon: string; author: string }[];
}
const { year, day, dayIcons } = Astro.props;
const date = `${year}-12-${String(day).padStart(2, "0")}`;
---
<button
  type="button"
  class:list={["day-tag", { "christmas-day": day === 25 }]}
  data-day={day}
  data-date={date}
  data-count={dayIcons.length}
  aria-label={`12月${day}日：公開前`}
  aria-pressed="false"
  disabled
>
  <span class="day-number">{day}</span>
  <span class="day-icons" hidden>
    {dayIcons.length > 0 && <img src={dayIcons[0].icon} alt="" width="64" height="64" />}
    {dayIcons.length > 1 && <span class="more-authors">+{dayIcons.length - 1}</span>}
  </span>
  <span class="day-symbol" aria-hidden="true">{day === 25 ? "✧" : "·"}</span>
  <span class="day-status">公開前</span>
</button>
